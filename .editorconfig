# EditorConfig: https://editorconfig.org
# Base style for the whole repository. Language sections below refine it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 80

[*.{c,h}]
indent_size = 4
max_line_length = 100

[*.{cc,cpp,cxx,hpp,hh,hxx}]
indent_size = 4
max_line_length = 100

[*.java]
indent_size = 2
max_line_length = 100

[*.go]
indent_style = tab

[*.py]
indent_size = 4
max_line_length = 100

[*.{md,markdown,typ}]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
